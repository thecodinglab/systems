@@ -0,0 +1,171 @@
+//! External requests to show a workspace, on Local or on a saved SSH machine.
+//!
+//! The socket API reaches one server, never the client that chooses which
+//! machine a window shows, so a tool running in a pane (a project switcher,
+//! say) has no way to bring up a workspace on another machine. It writes
+//! `activate-request.json` in the client state directory instead:
+//!
+//! ```json
+//! {"nonce": "unique", "machine": "<profile id, empty for Local>", "workspace": "w1"}
+//! ```
+//!
+//! Every attached client answers in `activate-ack.json`, first with
+//! `{"nonce": ..., "state": "received"}` at once, so the tool knows a client
+//! listens, then with `"state": "done"` once it activates that machine and
+//! workspace the way a sidebar click does. A machine saved a moment ago is
+//! waited for until its catalog entry is loaded and it is connected, for
+//! `PATIENCE` at most. A request already there when a client starts is
+//! never acted on.
+
+use super::*;
+
+use serde::{Deserialize, Serialize};
+
+/// How long a request waits for its machine to be saved and connected.
+const PATIENCE: Duration = Duration::from_secs(30);
+/// How often a waiting request looks again.
+const RETRY: Duration = Duration::from_millis(200);
+
+#[derive(Deserialize)]
+struct ActivationRequestFile {
+    nonce: String,
+    #[serde(default)]
+    machine: String,
+    workspace: String,
+}
+
+#[derive(Serialize)]
+struct ActivationAck<'a> {
+    nonce: &'a str,
+    state: &'a str,
+}
+
+/// A request waiting for its machine, as the client loop sees it.
+pub(super) struct ActivationRequest {
+    pub(super) nonce: String,
+    pub(super) endpoint_id: endpoint::ClientEndpointId,
+    pub(super) workspace: String,
+    pub(super) deadline: std::time::Instant,
+}
+
+fn request_path() -> std::path::PathBuf {
+    crate::config::state_dir()
+        .join("client")
+        .join("activate-request.json")
+}
+
+fn ack_path() -> std::path::PathBuf {
+    crate::config::state_dir()
+        .join("client")
+        .join("activate-ack.json")
+}
+
+fn read_request(path: &std::path::Path) -> Option<ActivationRequestFile> {
+    let data = std::fs::read(path).ok()?;
+    // a request is a few ids, anything bigger is not one
+    if data.len() > 4096 {
+        return None;
+    }
+    serde_json::from_slice(&data).ok()
+}
+
+fn modified(path: &std::path::Path) -> Option<std::time::SystemTime> {
+    std::fs::metadata(path).ok()?.modified().ok()
+}
+
+pub(super) fn write_ack(nonce: &str, state: &str) {
+    let path = ack_path();
+    let Ok(data) = serde_json::to_vec(&ActivationAck { nonce, state }) else {
+        return;
+    };
+    let temp = path.with_extension(format!("json.{}", std::process::id()));
+    if std::fs::write(&temp, data).is_ok() && std::fs::rename(&temp, &path).is_err() {
+        let _ = std::fs::remove_file(&temp);
+    }
+}
+
+/// Whether the client can activate the request's machine now: it is in the
+/// loaded catalog, enabled, and connected. Local always is.
+pub(super) fn ready(
+    request: &ActivationRequest,
+    catalog: &endpoint::EndpointCatalog,
+    endpoints: &endpoint::EndpointRegistry,
+) -> bool {
+    let known = match &request.endpoint_id {
+        endpoint::ClientEndpointId::Local => true,
+        endpoint::ClientEndpointId::Ssh(id) => catalog
+            .ssh
+            .iter()
+            .any(|profile| &profile.id == id && profile.enabled),
+    };
+    known && endpoints.connection(&request.endpoint_id).is_some()
+}
+
+/// Sends a request that is not ready yet back to the loop a little later,
+/// until its deadline.
+pub(super) fn retry(
+    event_tx: tokio::sync::mpsc::Sender<ClientLoopEvent>,
+    request: ActivationRequest,
+) {
+    if std::time::Instant::now() >= request.deadline {
+        warn!(nonce = %request.nonce, "activation request expired before its machine was ready");
+        return;
+    }
+    std::thread::spawn(move || {
+        std::thread::sleep(RETRY);
+        let _ = event_tx.blocking_send(ClientLoopEvent::ActivationRequest(request));
+    });
+}
+
+pub(super) fn watch_requests(
+    event_tx: tokio::sync::mpsc::Sender<ClientLoopEvent>,
+    should_quit: Arc<AtomicBool>,
+) {
+    // A stat every 100ms; the file is only read when it changed.
+    std::thread::spawn(move || {
+        let path = request_path();
+        let mut last_modified = modified(&path);
+        let mut last_nonce = read_request(&path).map(|request| request.nonce);
+        while !should_quit.load(Ordering::Acquire) {
+            std::thread::sleep(Duration::from_millis(100));
+            let current = modified(&path);
+            if current.is_none() || current == last_modified {
+                continue;
+            }
+            last_modified = current;
+            let Some(request) = read_request(&path) else {
+                continue;
+            };
+            if last_nonce.as_deref() == Some(request.nonce.as_str()) {
+                continue;
+            }
+            last_nonce = Some(request.nonce.clone());
+            let endpoint_id = if request.machine.is_empty() {
+                endpoint::ClientEndpointId::Local
+            } else {
+                match endpoint::ProfileId::parse(request.machine) {
+                    Ok(profile) => endpoint::ClientEndpointId::Ssh(profile),
+                    Err(error) => {
+                        warn!(%error, "ignoring activation request for an invalid machine");
+                        continue;
+                    }
+                }
+            };
+            if request.workspace.is_empty() {
+                continue;
+            }
+            write_ack(&request.nonce, "received");
+            if event_tx
+                .blocking_send(ClientLoopEvent::ActivationRequest(ActivationRequest {
+                    nonce: request.nonce,
+                    endpoint_id,
+                    workspace: request.workspace,
+                    deadline: std::time::Instant::now() + PATIENCE,
+                }))
+                .is_err()
+            {
+                break;
+            }
+        }
+    });
+}
